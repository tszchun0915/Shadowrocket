hostname = %APPEND% www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, s.youtube.com, *.googlevideo.com, *.doubleclick.net, *.ytimg.com, jnn-pa.googleapis.com, youtubei-att.googleapis.com, -gemini.google.com, -generativelanguage.googleapis.com, -www.google.com, -google.com, -redirector*.googlevideo.com
