#!url=https://raw.githubusercontent.com/tszchun0915/Shadowrocket/refs/heads/main/YTMod.Module
#!name=YT(Music)Enhance M
#!desc=PiP+Ambient Mode enabled - Optimized
#!arguments=請求處理服務:https://stream.maasea.workers.dev, 屏蔽上傳按鈕:true, 屏蔽選段按鈕:true, 屏蔽Shorts按鈕:false, 字幕翻譯語言:zh-Hant, 歌詞翻譯語言:zh-Hant, 啟用調試模式:false, 腳本執行引擎:webview
#!arguments-desc=- 屏蔽參數：[true, false]\n- 翻譯參數：[語言代碼, off]\n- 腳本執行引擎:[jsc, webview]
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

[Rule]
# 已移除影響流暢度嘅 UDP REJECT，現在廣告主要靠後端 + API 判斷
# AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT   ← 註解或刪
# AND,((URL-REGEX,(^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$)),(PROTOCOL,UDP)),REJECT-200   ← 註解或刪

[URL Rewrite]
# 優化 ctier=L 移除（單一規則，更穩更少誤殺）
^https?:\/\/[\w-]+\.googlevideo\.com\/.+?([,&/%2C]ctier *= *L|ctier\/L).* https://$& reject   # 或用 302 移除 ctier 參數： $1$2$3 302（視工具支援）

# 或者更精準版（推薦，保留其他參數）
^https?:\/\/([^/]+\.googlevideo\.com\/.+?)(?:[,&]ctier *= *L|ctier\/L)([^,]*)(,ctier=[^&]*)?(.*)$ $1$2$4 302

# 攔截廣告影片流（加強版，加入 2026 新特徵）
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.*[?&]oad= reject-200
^https?:\/\/[\w-]+\.googlevideo\.com\/.*[?&](oad=|pltype=ad|adformat=|ad_type=|adcompanion|segsrc=|pfa=) reject-200
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?|.*\/initplayback)).*(&|,)(oad=|segsrc=|expire=|pfa=|ad_|midroll) reject-200
^https?:\/\/[\w-]+\.googlevideo\.com\/.*&pltype=ad.* reject-200

# 攔截統計追蹤 / API 廣告相關
^https?:\/\/s\.youtube\.com\/api\/stats\/(ads|qoe\?adcontext|adsense.*|gfp_.*|ad_) reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking|get_midroll|.*ad_break.*|.*ad_.+?\.js|api\/stats\/qoe) reject-200

# 攔截 DoubleClick / 其他廣告域
^https?:\/\/[^\/]*\.doubleclick\.net\/ reject-200

# API 轉發（去廣告核心，保持你原本設定）
^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(next|player|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event))(\?(.*))?$ {{{請求處理服務}}}/$1?blockUpload={{{屏蔽上傳按鈕}}}&blockImmersive={{{屏蔽選段按鈕}}}&blockShorts={{{屏蔽Shorts按鈕}}}&engine={{{腳本執行引擎}}}&captionLang={{{字幕翻譯語言}}}&lyricLang={{{歌詞翻譯語言}}}&$4 307

[MITM]
hostname = %APPEND% www.youtube.com, s.youtube.com, music.youtube.com, youtubei.googleapis.com, rr*.googlevideo.com, manifest.googlevideo.com, jnn-pa.googleapis.com, -gemini.google.com, -generativelanguage.googleapis.com, -www.google.com*, -google.com*
